<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:padding="16dp">

    <TextView
        android:id="@+id/txtQuestsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="My Quests"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1E1B2E"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnFilterAll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="6dp"
        android:backgroundTint="#7C3AED"
        android:textColor="@android:color/white"
        android:text="All"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnFilterPending"
        app:layout_constraintTop_toBottomOf="@id/txtQuestsTitle"
        app:layout_constraintHorizontal_chainStyle="spread" />

    <Button
        android:id="@+id/btnFilterPending"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:backgroundTint="#EDE9FE"
        android:textColor="#1E1B2E"
        android:text="Pending"
        app:layout_constraintStart_toEndOf="@id/btnFilterAll"
        app:layout_constraintEnd_toStartOf="@id/btnFilterCompleted"
        app:layout_constraintTop_toTopOf="@id/btnFilterAll" />

    <Button
        android:id="@+id/btnFilterCompleted"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:backgroundTint="#EDE9FE"
        android:textColor="#1E1B2E"
        android:text="Completed"
        app:layout_constraintStart_toEndOf="@id/btnFilterPending"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnFilterAll" />

    <TextView
        android:id="@+id/txtEmptyQuests"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:gravity="center"
        android:text="No quests yet.\nCreate your first quest and start earning XP."
        android:textColor="#6B7280"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnFilterAll" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerQuests"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnFilterAll"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>