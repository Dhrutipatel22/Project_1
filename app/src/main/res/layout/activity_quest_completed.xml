<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:padding="24dp">

    <ImageView
        android:id="@+id/imgCheckCircle"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:padding="24dp"
        android:src="@android:drawable/checkbox_on_background"
        android:background="@drawable/bg_success_circle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.25" />

    <TextView
        android:id="@+id/txtCompleteTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Quest Complete!"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#7C3AED"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgCheckCircle" />

    <TextView
        android:id="@+id/txtXpEarned"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="+20 XP"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#22C55E"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtCompleteTitle" />

    <ProgressBar
        android:id="@+id/progressCompleted"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:layout_marginTop="20dp"
        android:max="100"
        android:progressTint="#7C3AED"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtXpEarned" />

    <TextView
        android:id="@+id/txtXpProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="0 / 200 XP"
        android:textSize="13sp"
        android:textColor="#6B7280"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressCompleted" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardLevelUp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:visibility="gone"
        app:cardCornerRadius="14dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="@android:color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtXpProgress">

        <TextView
            android:id="@+id/txtLevelUpMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:text="🎖️ Level Up! You reached Level 2"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1E1B2E" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Badge Unlocked callout (hidden unless applicable) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBadgeUnlocked"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        app:cardCornerRadius="14dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="@android:color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardLevelUp">

        <TextView
            android:id="@+id/txtBadgeUnlockedMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:text="🏆 New Badge Unlocked! First Quest"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1E1B2E" />

    </com.google.android.material.card.MaterialCardView>

    <Button
        android:id="@+id/btnAwesome"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#7C3AED"
        android:text="Awesome!"
        android:textColor="@android:color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>